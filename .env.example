# Supabase Configuration for Academia-Industry Nexus
# Replace with your Supabase Project URL and Anon Public Key from Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Keep this false in production. Never put a Supabase service-role key in VITE_* variables.
VITE_ALLOW_DEMO_AUTH=false
